--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,48 @@
+# Generated by Repo Doctor — edit to fit your project
+name: CI
+
+on:
+  push:
+    branches: [ main, master ]
+  pull_request:
+    branches: [ main, master ]
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      # -- Python ----------------------------------------------------------
+      - name: Set up Python
+        if: hashFiles('pyproject.toml') != '' || hashFiles('requirements*.txt') != ''
+        uses: actions/setup-python@v5
+        with:
+          python-version: '3.11'
+
+      - name: Install Python dependencies
+        if: hashFiles('pyproject.toml') != '' || hashFiles('requirements*.txt') != ''
+        run: |
+          pip install --upgrade pip
+          pip install -r requirements.txt 2>/dev/null || pip install .
+
+      - name: Run Python tests
+        if: hashFiles('pyproject.toml') != '' || hashFiles('requirements*.txt') != ''
+        run: |
+          python -m pytest --tb=short -q 2>/dev/null || echo "No tests found"
+
+      # -- Node ------------------------------------------------------------
+      - name: Set up Node
+        if: hashFiles('package.json') != ''
+        uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+          cache: 'npm'
+
+      - name: Install Node dependencies
+        if: hashFiles('package.json') != ''
+        run: npm ci
+
+      - name: Run Node tests
+        if: hashFiles('package.json') != ''
+        run: npm test --if-present
